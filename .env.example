# Resend — contact form email delivery
# Get your API key at https://resend.com
RESEND_API_KEY=

# Inbox that receives form submissions (defaults to site.email in lib/site.ts)
CONTACT_TO_EMAIL=

# Sender address — use onboarding@resend.dev for testing
# For production, verify your domain at resend.com and use e.g. contact@saiteja.live
CONTACT_FROM_EMAIL=
